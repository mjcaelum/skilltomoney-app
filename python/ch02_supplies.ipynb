      "source": [
        "people = int(input(\"신청 인원: \"))\n",
        "books = (people + 4) // 5\n",
        "water = (people + 5) // 6\n",
        "total = books * 12000 + water * 3000\n",
        "print(\"교재\", books, \"묶음\")\n",
        "print(\"생수\", water, \"묶음\")\n",
        "print(\"준비 비용\", total, \"원\")\n"
      ]
    }
  ]
